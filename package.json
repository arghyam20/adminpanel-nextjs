{
  "name": "adminpanel-nextjs",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate --schema src/api/prisma/schema && next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "prisma:generate": "prisma generate --schema src/api/prisma/schema",
    "prisma:migrate": "prisma migrate dev --schema src/api/prisma/schema",
    "prisma:seed": "tsx src/api/prisma/seed.ts"
  },
  "dependencies": {
    "@emotion/cache": "^11.14.0",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@hookform/resolvers": "^5.0.1",
    "@mui/icons-material": "^7.0.0",
    "@mui/material": "^7.0.0",
    "@prisma/client": "^6.8.0",
    "axios": "^1.16.1",
    "bcryptjs": "^3.0.2",
    "jose": "^6.0.11",
    "next": "^16.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.0",
    "react-hot-toast": "^2.5.2",
    "slugify": "^1.6.6",
    "swagger-ui-react": "^5.21.0",
    "zod": "^3.24.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.2",
    "@types/swagger-ui-react": "^5.18.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-config-next": "^16.2.0",
    "postcss": "^8.5.3",
    "prettier": "^3.5.3",
    "prisma": "^6.8.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
