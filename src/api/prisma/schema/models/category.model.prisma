model Category {
  id        Int       @id @default(autoincrement())
  name      String
  slug      String    @unique
  status    Status    @default(ACTIVE)
  deletedAt DateTime?
  isDeleted Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  blogs     Blog[]

  @@index([status, isDeleted])
}
