model Blog {
  id              Int       @id @default(autoincrement())
  title           String    @db.VarChar(300)
  slug            String    @unique @db.VarChar(350)
  excerpt         String?   @db.Text
  content         String    @db.LongText
  featuredImage   String?   @db.VarChar(500)
  metaTitle       String?   @db.VarChar(160)
  metaDescription String?   @db.VarChar(320)
  tags            Json      // stored as LongText in MySQL
  status          Status    @default(ACTIVE)
  publishedAt     DateTime?
  categoryId      Int
  authorId        Int
  isDeleted       Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  category Category @relation(fields: [categoryId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])

  @@index([categoryId, status, isDeleted])
  @@index([authorId, status, isDeleted])
  @@index([slug])
  @@index([publishedAt, status, isDeleted])
  @@map("blog")
}
