model Faq {
  id        Int       @id @default(autoincrement())
  question  String
  answer    String    @db.Text
  ordering  Int       @default(0)
  status    Status    @default(Status.ACTIVE)
  deletedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([ordering, status, deletedAt])
}
