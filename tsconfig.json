{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "baseUrl": ".",
    "paths": {
      "@/components/*": [
        "src/components/*"
      ],
      "@/providers/*": [
        "src/providers/*"
      ],
      "@/lib/env": [
        "src/config/env"
      ],
      "@/lib/prisma": [
        "src/config/prisma"
      ],
      "@/lib/*": [
        "src/lib/*"
      ],
      "@/api/*": [
        "src/api/*"
      ],
      "@/modules/*": [
        "src/api/modules/*"
      ],
      "@/repositories/*": [
        "src/api/repositories/*"
      ],
      "@/services/*": [
        "src/api/services/*"
      ],
      "@/validations/*": [
        "src/api/validations/*"
      ],
      "@/config/*": [
        "src/config/*"
      ],
      "@/constants/*": [
        "src/constants/*"
      ],
      "@/types/*": [
        "src/types/*"
      ],
      "@/*": [
        "src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next/**",
    ".next/dev/**",
    "src/api/docs/swagger.ts",
    "src/api/docs/openapi.ts",
    "src/api/middleware/**",
    "src/api/routes/**",
    "src/api/server.ts",
    "src/api/validations/user.validation.ts"
  ]
}
