model Testimonial {
  id          Int       @id @default(autoincrement())
  clientName  String
  designation String?
  image       String?
  rating      Int       @default(5)
  content     String    @db.Text
  status      Status    @default(Status.ACTIVE)
  deletedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([status, deletedAt])
}
